{
  "name": "qst-report-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply qst-reports --local",
    "db:migrate:remote": "wrangler d1 migrations apply qst-reports --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  }
}
