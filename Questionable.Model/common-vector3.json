{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qstxiv.github.io/schema/common-vector3.json",
  "description": "Position in the world: [X, Y, Z], or the older {\"X\", \"Y\", \"Z\"} object",
  "oneOf": [
    {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    {
      "type": "object",
      "properties": {
        "X": {
          "type": "number"
        },
        "Y": {
          "type": "number"
        },
        "Z": {
          "type": "number"
        }
      },
      "required": [
        "X",
        "Y",
        "Z"
      ]
    }
  ]
}
